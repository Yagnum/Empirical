# Copy this file to .env and fill in real values. Never commit .env.

# Alpaca Broker API — SANDBOX keys (https://broker-app.alpaca.markets)
# The keys must have WRITE access (a read-only key can list accounts but
# returns 403 "request is forbidden" on account creation).
ALPACA_BROKER_ID=
ALPACA_BROKER_SECRET=

# Firm/sweep account UUID for instant journal funding (ADR-011).
# Broker dashboard -> Accounts -> Firm Accounts. Leave empty to fall back
# to ACH transfers (limited to 1/day, takes minutes to clear in sandbox).
ALPACA_FIRM_ACCOUNT_ID=

# Jupiter API (used in later crypto phases)
JUP_API_KEY=

# Clerk backend key (Phase 1) — https://dashboard.clerk.com
CLERK_SECRET_KEY=

# Set to false in production: reject session tokens without an `azp` claim
# (only scripts/dev_token.py mints such tokens, for Swagger and Postman).
ALLOW_TOKENS_WITHOUT_AZP=true

# Clerk webhook signing secret (ADR-015) — Dashboard -> Webhooks ->
# endpoint -> Signing Secret, starts with `whsec_`. Leave empty to disable
# POST /webhooks/clerk (it answers 503 rather than accept unsigned events).
CLERK_WEBHOOK_SIGNING_SECRET=
